# 长难句拆解台 · 环境变量（复制成 .env 再改；.env 不要提交到 Git，不要发给别人）
# 服务器上已经有 setup.sh 生成的 .env 时，不需要用这个文件，只要把下面“国内大模型”一段补进去。

# 网站容器的端口。开了 HTTPS（scripts/enable-https.sh）后脚本会改成 WEB_BIND=127.0.0.1、WEB_PORT=8081，
# 只让服务器上的 Nginx 访问，外面一律走 https（端口记在脚本写入的 HTTPS_PORT 里，默认 8443，用 --port 换）
WEB_PORT=80
# WEB_BIND=0.0.0.0

# 数据库
POSTGRES_DB=sentence
POSTGRES_USER=sentence
POSTGRES_PASSWORD=换成一串随机密码

# 访问密码：打开网站时输入的密码。改了之后重启 api，旧的登录状态全部失效
ACCESS_PASSWORD=换成你自己的访问密码
# 至少 32 个字符的随机串，可以用 openssl rand -hex 32 生成
COOKIE_SECRET=换成一串至少32个字符的随机字符

# 国内大模型：更推荐在网站的“设置”页里填写（保存后立即生效，并且优先于这里）。
# 任何兼容 OpenAI 接口格式的服务都可以，地址填到 /v1 这一级
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com/v1                         LLM_MODEL_MAIN=deepseek-v4-pro  LLM_MODEL_LIGHT=deepseek-flash
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1    LLM_MODEL_MAIN=qwen-plus   LLM_MODEL_LIGHT=qwen-turbo
# 智谱 GLM：  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                LLM_MODEL_MAIN=glm-4-plus  LLM_MODEL_LIGHT=glm-4-flash
# Kimi：      LLM_BASE_URL=https://api.moonshot.cn/v1                          LLM_MODEL_MAIN=moonshot-v1-8k
# 模型名会更新，以各平台文档为准。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_MAIN=
# 查词用的轻量模型，不填就用主力模型
LLM_MODEL_LIGHT=
# 模型不支持 JSON 输出模式（报错里提到 response_format）时改成 0
LLM_JSON_MODE=1
# 深度思考：默认关掉（DeepSeek 等新模型默认会思考，批改、查词用不到，开着又慢又贵）；想开改成 1
LLM_THINKING=0

# ChatGPT 套餐（只给你自己的账户用，在网站“设置”→“ChatGPT 套餐”里连接）。
# 服务器在国内连不上 OpenAI：填 Clash 的 HTTP 代理地址，只有发往 OpenAI 的请求会走它，国内模型照旧直连。
# 不要另外设 HTTP_PROXY / HTTPS_PROXY。Clash 要打开 allow-lan，给 openai.com 用 OpenAI 支持地区的节点（不能是香港），
# 代理端口不要对公网开放。详细步骤见 README 的“ChatGPT 套餐”一节。
# - mihomo 跑在 Docker 的 proxy-net 网络里：写 http://mihomo:7890，并用 docker-compose.override.yml 让 api 加入 proxy-net
# - Clash 装在宿主机上：写 http://host.docker.internal:7890
# - Clash 开了用户名密码：写成 http://用户名:密码@地址:端口
# 改完执行 sudo docker compose up -d --force-recreate api，再用 sudo docker compose exec api node scripts/check-openai.ts 检查
# OPENAI_PROXY=http://mihomo:7890

# 每日上限
DAILY_GRADE_LIMIT=100
DAILY_LOOKUP_LIMIT=300
# 每天“加练”出题的次数上限（今日任务不算）
DAILY_GENERATE_LIMIT=10

# 每天自动出题（北京时间），整个网站都不想要就把 DAILY_GENERATE 改成 0
DAILY_GENERATE=1
# 默认的出题时间；每个账户可以在网站“设置”→“每日任务”里改成自己的时间，或者关掉自动生成
DAILY_GENERATE_HOUR=7
DAILY_GENERATE_MINUTE=50
# 每天几句、出四级还是六级，在网站“设置”页的“每日任务”里改（1–10 句）；这里只是第一次的默认句数
DAILY_GENERATE_COUNT=5

# 登录 Cookie 只通过 HTTPS 传输；scripts/enable-https.sh 会自动改成 1
COOKIE_SECURE=0

# 构建镜像时装 npm 依赖用的源，默认腾讯云镜像；慢或者装不上时可以换，比如 https://registry.npmmirror.com/
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
