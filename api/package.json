{
  "name": "@sentence-site/api",
  "version": "1.0.0",
  "private": true,
  "description": "长难句拆解台 · 后端",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
