    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@sentence-site/shared": "*",
    "@types/pg": "^8.15.5"
  }
}
